# Base URL of micash-api (server-side only; never exposed to the browser).
# On the VPS use the internal Docker address (e.g. http://api:8080), never the public URL through Traefik:
# the API only accepts the visitor's IP (X-Forwarded-For, used by its rate limits) from the private network.
MICASH_API_URL=http://localhost:5203
